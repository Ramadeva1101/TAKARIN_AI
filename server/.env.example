AI_MODE=fixture
PORT=3001
JWT_SECRET=ganti-dengan-string-acak
DB_PATH=./data/app.db
KELONTONG_BASE_URL=https://api.kelontongai.id/v1
KELONTONG_API_KEY=
MODEL_NOTA=minimax-m3.1-flash
MODEL_NOTA_FALLBACK=gpt-5.6-luna,gpt-6-astra-ultrafast
MODEL_TEKS=deepseek-v4-flash
MODEL_TEKS_FALLBACK=deepseek-v4-flash-0731,gpt-6-astra-ultrafast,glm-5.3-flash,gpt-5.6-luna
GROQ_API_KEY=
# on = ambil harga pasar dari PIHPS Bank Indonesia (bi.go.id/hargapangan); kosongkan untuk memakai data impor/contoh saja
HARGA_LIVE=on
# on = akun demo (demo@dapur.id) dikembalikan ke data awal setiap server dinyalakan dan setiap tengah malam
DEMO_RESET=on
# Jumlah permintaan AI yang boleh berjalan bersamaan dari server ini (batas penyedia per kunci API)
AI_PARALEL=2
